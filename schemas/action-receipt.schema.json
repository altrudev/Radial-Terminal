{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radial-terminal.altru.dev/schemas/action-receipt.schema.json",
  "title": "Radial Terminal Action Receipt",
  "type": "object",
  "required": [
    "receipt_version",
    "receipt_id",
    "nonce",
    "session_id",
    "mode",
    "host_identity",
    "requested_command_sha256",
    "providers",
    "assurance_bypassed",
    "disposition",
    "findings",
    "requested_at",
    "decision_at",
    "observations"
  ],
  "properties": {
    "receipt_version": { "const": "0.2" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 16 },
    "session_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["DIRECT", "GUARDED", "ASSURED"] },
    "host_identity": {
      "type": "object",
      "required": ["hostname", "port", "verified"],
      "properties": {
        "hostname": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "verified": { "type": "boolean" },
        "host_key_sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9+/=:_-]{16,}$"
        }
      },
      "additionalProperties": false
    },
    "requested_command_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "executed_command_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "policy_id": { "type": ["string", "null"] },
          "policy_version": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "assurance_bypassed": { "type": "boolean" },
    "disposition": {
      "enum": ["ALLOW", "REVIEW", "BLOCK"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "summary"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "requested_at": { "type": "string", "format": "date-time" },
    "decision_at": { "type": "string", "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" },
    "executed_at": { "type": ["string", "null"], "format": "date-time" },
    "exit_code": { "type": ["integer", "null"] },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "summary"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "observed_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
